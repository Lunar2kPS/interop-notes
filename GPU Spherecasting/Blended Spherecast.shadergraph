{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f1516a63e4b243a1a75787f046981189",
    "m_Title": "Curve Adjustments",
    "m_Content": "This adjusts the raw 3D math formula in the following ways:\n- Integrate spherecast radius (localRadius property).\n- Adjust the curving of the fade using a power/exponentiation function.\n- Integrate the BaseColor's alpha value across the entire model uniformly.\n-Multiply a higher-precision alphaMultiplier value uniformly as well.\n- Clamp again in range [0, 1].\n- Scale the final value to be in range [alphaRange.x, alphaRange.y], in case you wish to make the whole curve go between other min/max values other than 0 and 1.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 58.0,
        "y": 130.0,
        "width": 249.0,
        "height": 248.29635620117188
    },
    "m_Group": {
        "m_Id": ""
    }
}

