{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "e5fb0d3851ea429f9e729bad97cedf64",
    "m_Title": "Shader Summary",
    "m_Content": "This shader allows us to render a transparent, faded hole around a given infinite line in the local-space of the 3D model.\n\nIn the graph, we project the line's nearest point to the current fragment/interpolated position on the triangle of the mesh, and calculate the distance to that nearest point.\n\nThen, based on the radius of the spherecast, we made (approximately) that distance/radius around the line maximally transparent, limited by the alphaRange property (which allows you to customize the min/max alpha values, if you don't want to go all the way from a = 0 to a = 1).\n",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 656.0,
        "y": -822.0,
        "width": 353.0,
        "height": 258.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

